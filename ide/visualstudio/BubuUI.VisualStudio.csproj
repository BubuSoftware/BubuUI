<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>BubuUI.VisualStudio</RootNamespace>
    <AssemblyName>BubuUI.VisualStudio</AssemblyName>
    <Version>0.2.0</Version>
    <ImplicitUsings>disable</ImplicitUsings>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <DeployExtension>false</DeployExtension>
    <UseCodebase>true</UseCodebase>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/RootSuffix Exp</StartArguments>
  </PropertyGroup>
  <ItemGroup>
    <!-- These assemblies belong to VS, never ship private copies into its process. -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.CoreUtility" Version="17.14.249" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Text.Logic" Version="17.14.249" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="BubuUI.pkgdef" IncludeInVSIX="true" />
    <Content Include="..\vscode\syntaxes\*.tmLanguage.json" Link="Grammars\%(Filename)%(Extension)" IncludeInVSIX="true" />
    <Content Include="..\vscode\language-configuration.json" Link="Grammars\language-configuration.json" IncludeInVSIX="true" />
    <Content Include="..\vscode\bss-language-configuration.json" Link="Grammars\bss-language-configuration.json" IncludeInVSIX="true" />
  </ItemGroup>
  <!-- Evaluate after publish, including when MSBuild was already running during publish. -->
  <Target Name="IncludeBubuUiServer" BeforeTargets="GetVsixSourceItems">
    <Error Condition="!Exists('server\BubuUI.LanguageServer.dll')" Text="Bundled language server missing. Run ide\visualstudio\build.ps1 first." />
    <ItemGroup>
      <Content Include="server\**\*" IncludeInVSIX="true" />
    </ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" />
</Project>
