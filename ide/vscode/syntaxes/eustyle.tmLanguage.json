{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Eustyle",
  "scopeName": "source.eustyle",
  "fileTypes": ["eustyle"],
  "comment": "Eustyle：SCSS 子集，编译成 StyleRegistry 调用（design/17 §4.8）。同一份 grammar 也嵌在 .ui 的 @style 块里。",
  "patterns": [
    { "include": "#comment" },
    { "include": "#directive" },
    { "include": "#variable" },
    { "include": "#function" },
    { "include": "#color" },
    { "include": "#property" },
    { "include": "#class-selector" },
    { "include": "#pseudo-class" },
    { "include": "#type-selector" },
    { "include": "#number" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.eustyle" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.eustyle" }
      ]
    },

    "directive": {
      "match": "(@)(states|style)\\b",
      "captures": {
        "1": { "name": "punctuation.definition.directive.eustyle" },
        "2": { "name": "keyword.control.directive.eustyle" }
      }
    },

    "variable": {
      "comment": "定义形态（$name:）必须排在引用形态之前，否则冒号会落到 property 规则上。",
      "patterns": [
        {
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_-]*)(\\s*)(:)",
          "name": "meta.definition.variable.eustyle",
          "captures": {
            "1": { "name": "punctuation.definition.variable.eustyle" },
            "2": { "name": "variable.other.eustyle" },
            "4": { "name": "punctuation.separator.key-value.eustyle" }
          }
        },
        {
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_-]*)",
          "captures": {
            "1": { "name": "punctuation.definition.variable.eustyle" },
            "2": { "name": "variable.other.eustyle" }
          }
        }
      ]
    },

    "function": {
      "match": "\\b(theme|rgb|rgba)\\b(?=\\s*\\()",
      "name": "support.function.eustyle"
    },

    "color": {
      "match": "#[0-9a-fA-F]{3,8}\\b",
      "name": "constant.other.color.eustyle"
    },

    "property": {
      "match": "([A-Za-z_][A-Za-z0-9_]*)(\\s*)(:)(?!:)",
      "captures": {
        "1": { "name": "support.type.property-name.eustyle" },
        "3": { "name": "punctuation.separator.key-value.eustyle" }
      }
    },

    "class-selector": {
      "match": "(\\.)([A-Za-z_][A-Za-z0-9_-]*)",
      "captures": {
        "1": { "name": "punctuation.definition.selector.eustyle" },
        "2": { "name": "entity.other.attribute-name.class.eustyle" }
      }
    },

    "pseudo-class": {
      "match": "(::?)([A-Za-z_][A-Za-z0-9_-]*)",
      "captures": {
        "1": { "name": "punctuation.definition.pseudo.eustyle" },
        "2": { "name": "entity.other.attribute-name.pseudo-class.eustyle" }
      }
    },

    "type-selector": {
      "match": "\\b[A-Z][A-Za-z0-9]*\\b",
      "name": "entity.name.tag.eustyle"
    },

    "number": {
      "match": "\\b\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.eustyle"
    },

    "punctuation": {
      "patterns": [
        { "match": "[{}]", "name": "punctuation.section.block.eustyle" },
        { "match": "[()]", "name": "punctuation.section.parens.eustyle" },
        { "match": "[;]", "name": "punctuation.terminator.eustyle" },
        { "match": "[>,]", "name": "punctuation.separator.selector.eustyle" },
        { "match": "&", "name": "keyword.operator.nesting.eustyle" }
      ]
    }
  }
}
