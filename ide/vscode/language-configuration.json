{
  "comments": {
    "blockComment": [
      "@*",
      "*@"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "<",
      ">"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "@*",
      "close": "*@",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "<!--",
      "close": "-->",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "<",
      "close": ">"
    }
  ],
  "autoCloseBefore": ";:.,=}])> \n\t\"",
  "folding": {
    "markers": {
      "start": "^\\s*<!--\\s*#?region\\b.*-->",
      "end": "^\\s*<!--\\s*#?endregion\\b.*-->"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{\\s*$|^\\s*<[A-Za-z_][\\w.:]*(?:\\s+[^<>]*)?(?<!/)>\\s*$",
    "decreaseIndentPattern": "^\\s*(</|\\}|/>)"
  },
  "wordPattern": "(@?[A-Za-z_][A-Za-z0-9_.-]*)",
  "onEnterRules": [
    {
      "beforeText": "^\\s*<([A-Za-z_][\\w.:]*)(?:\\s+[^<>]*)?(?<!/)>\\s*$",
      "afterText": "^\\s*</[A-Za-z_][\\w.:]*\\s*>",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*(?:@(?:if|foreach|for|while|switch)\\b.*|@do\\s*|else\\b.*)\\{\\s*$",
      "afterText": "^\\s*}",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*<([A-Za-z_][\\w.:]*)(?:\\s+[^<>]*)?(?<!/)>\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
