{
  "comments": {
    "blockComment": ["@*", "*@"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "@*", "close": "*@", "notIn": ["string"] },
    { "open": "<!--", "close": "-->", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" },
    { "open": "(", "close": ")" },
    { "open": "<", "close": ">" }
  ],
  "autoCloseBefore": ";:.,=}])> \n\t\"",
  "folding": {
    "markers": {
      "start": "^\\s*<!--\\s*#?region\\b.*-->",
      "end": "^\\s*<!--\\s*#?endregion\\b.*-->"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{\\s*$|^\\s*<[A-Za-z][^<>]*[^/]>\\s*$",
    "decreaseIndentPattern": "^\\s*(</|\\}|\\})"
  },
  "wordPattern": "(@?[A-Za-z_][A-Za-z0-9_.-]*)"
}
