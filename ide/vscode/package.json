{
  "name": "bubuui",
  "displayName": "BubuUI",
  "description": "BubuUI templates, styles and control themes: completion, diagnostics, navigation, rename and embedded C#.",
  "version": "0.2.0",
  "publisher": "bubuui",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "bubuui",
    "ui",
    "templates",
    "intellisense"
  ],
  "activationEvents": [
    "onLanguage:bubuui",
    "onLanguage:bss",
    "workspaceContains:**/*.bui"
  ],
  "main": "./client/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension starts the BubuUI language server (a local .NET process)."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "bubuui",
        "aliases": [
          "BubuUI",
          "bubuui"
        ],
        "extensions": [
          ".bui"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "bss",
        "aliases": [
          "Bss"
        ],
        "extensions": [
          ".bss"
        ],
        "configuration": "./bss-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bubuui",
        "scopeName": "source.bubuui",
        "path": "./syntaxes/bubuui.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.line.csharp.bubuui": "csharp",
          "meta.embedded.block.csharp.bubuui": "csharp",
          "meta.embedded.block.bss.bubuui": "bss"
        }
      },
      {
        "language": "bss",
        "scopeName": "source.bss",
        "path": "./syntaxes/bss.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "bubuui",
        "path": "./snippets/bubuui.json"
      }
    ],
    "commands": [
      {
        "command": "bubuui.reloadCatalog",
        "title": "BubuUI: Reload Tag Catalog"
      }
    ],
    "configuration": {
      "title": "BubuUI",
      "properties": {
        "bubuui.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to BubuUI.LanguageServer.dll. Empty = bundled server/ folder, then the repository build output."
        },
        "bubuui.server.dotnet": {
          "type": "string",
          "default": "dotnet",
          "description": "dotnet executable used to start the language server."
        },
        "bubuui.runtime.path": {
          "type": "string",
          "default": "",
          "description": "BubuUI.Runtime.dll or the directory containing it. Empty = auto-detect (server folder, then src/BubuUI.Runtime/bin/**)."
        },
        "bubuui.catalog.assemblies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra assemblies whose Element/Component types should become template tags (your app's output dll)."
        },
        "bubuui.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP traffic in the BubuUI output channel."
        }
      }
    }
  },
  "scripts": {
    "build:server": "dotnet publish ../BubuUI.LanguageServer -c Release -o server",
    "test": "node test/tokenize.test.js && node test/extension.test.js",
    "test:grammar": "node test/tokenize.test.js",
    "test:shell": "node test/extension.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CeSun/BubuUI.git",
    "directory": "ide/vscode"
  }
}
