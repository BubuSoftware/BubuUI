{
  "name": "bubuui-textmate",
  "displayName": "BubuUI TextMate bundle",
  "description": "Shared TextMate grammars for BubuUI .bui templates and .bss stylesheets (assembled from ide/vscode at build time).",
  "version": "0.2.0",
  "contributes": {
    "languages": [
      {
        "id": "bubuui",
        "aliases": ["BubuUI", "bubuui"],
        "extensions": [".bui"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "bss",
        "aliases": ["Bss", "bss"],
        "extensions": [".bss"],
        "configuration": "./bss-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bubuui",
        "scopeName": "source.bubuui",
        "path": "./syntaxes/bubuui.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.line.csharp.bubuui": "csharp",
          "meta.embedded.block.csharp.bubuui": "csharp",
          "meta.embedded.block.bss.bubuui": "bss"
        }
      },
      {
        "language": "bss",
        "scopeName": "source.bss",
        "path": "./syntaxes/bss.tmLanguage.json"
      }
    ]
  }
}
