<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>com.bubuui</id>
    <name>BubuUI</name>
    <vendor>BubuUI</vendor>
    <version>0.2.0</version>

    <description><![CDATA[
    BubuUI <code>.bui</code> templates and <code>.bss</code> stylesheets in Rider:
    syntax highlighting, diagnostics, completion, hover, go-to-definition, rename and
    more. All language intelligence comes from the shared <b>BubuUI.LanguageServer</b>
    over stdio via LSP4IJ -- the same server the VS Code extension uses.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <!-- LSP4IJ 0.21.0 requires 2024.2+. Keep in sync with gradle.properties. -->
    <idea-version since-build="242.*"/>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Language + FileType pairs let LSP4IJ map documents to the server
             and let the TextMate highlighter bind to concrete file types. -->
        <fileType name="BubuUI"
                  language="BubuUI"
                  extensions="bui"
                  implementationClass="com.bubuui.rider.BubuUiFileType"/>
        <fileType name="Bss"
                  language="Bss"
                  extensions="bss"
                  implementationClass="com.bubuui.rider.BssFileType"/>

        <!-- JetBrains TextMate bundles are read from disk, not from the classpath.
             The provider extracts /textmate (assembled by Gradle from ide/vscode)
             into the plugin directory and hands the path to the platform. -->
        <textmate.bundleProvider
                implementation="com.bubuui.rider.BubuUiTextMateBundleProvider"/>

        <!-- A custom FileType would otherwise suppress TextMate colouring. This
             explicit binding is the workaround LSP4IJ itself uses (see its
             plugin-textmate.xml); without it the grammars register but nothing
             is coloured. -->
        <editorHighlighterProvider
                filetype="BubuUI"
                implementationClass="com.bubuui.rider.BubuUiEditorHighlighterProvider"/>
        <lang.syntaxHighlighterFactory
                language="BubuUI"
                implementationClass="com.bubuui.rider.BubuUiSyntaxHighlighterFactory"/>
        <editorHighlighterProvider
                filetype="Bss"
                implementationClass="com.bubuui.rider.BubuUiEditorHighlighterProvider"/>
        <lang.syntaxHighlighterFactory
                language="Bss"
                implementationClass="com.bubuui.rider.BubuUiSyntaxHighlighterFactory"/>

        <!-- TextMate supplies colours; these parsers only split the PSI into
             words and punctuation so navigation highlights one name at a time. -->
        <lang.parserDefinition
                language="BubuUI"
                implementationClass="com.bubuui.rider.BubuUiParserDefinition"/>
        <lang.parserDefinition
                language="Bss"
                implementationClass="com.bubuui.rider.BssParserDefinition"/>

        <applicationService serviceImplementation="com.bubuui.rider.BubuUiSettings"/>
        <applicationConfigurable
                parentId="language"
                instance="com.bubuui.rider.BubuUiSettingsConfigurable"
                id="bubuui.settings"
                displayName="BubuUI"/>
        <notificationGroup id="BubuUI" displayType="BALLOON"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="bubuui"
                name="BubuUI Language Server"
                factoryClass="com.bubuui.rider.BubuUiLanguageServerFactory">
            <description><![CDATA[
            The shared BubuUI stdio language server (dotnet BubuUI.LanguageServer.dll).
            Diagnostics, completion, hover, navigation, rename, semantic tokens,
            code actions and formatting for .bui and .bss.
            ]]></description>
        </server>

        <!-- languageId mirrors the VS Code documentSelector. The server keys off
             the file extension, but keeping the LSP field correct costs nothing. -->
        <languageMapping language="BubuUI" serverId="bubuui" languageId="bubuui"/>
        <languageMapping language="Bss" serverId="bubuui" languageId="bss"/>

        <!-- Fallback for installations where the custom FileType is overridden
             (e.g. a user has assigned *.bui to "Files supported via TextMate
             bundles"). LSP4IJ recommends pattern mappings to keep TextMate
             colouring; do NOT enable both mappings at once for normal setups. -->
        <!-- <fileNamePatternMapping patterns="*.bui;*.bss" serverId="bubuui"/> -->
    </extensions>
</idea-plugin>
