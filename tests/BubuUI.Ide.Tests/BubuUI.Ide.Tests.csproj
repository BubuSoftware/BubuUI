<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- 与 LanguageServer 保持一致：ProjectSystemTests 在进程内加载本机 SDK 的 MSBuild，
         只有更高主版本的 SDK 时测试宿主也必须前滚，否则 System.Runtime 版本对不上。 -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 被测对象就是 server 本身（exe 程序集可以直接被测试项目引用）。 -->
    <ProjectReference Include="..\..\ide\BubuUI.LanguageServer\BubuUI.LanguageServer.csproj" />
    <!-- 让 BubuUI.Runtime.dll 落在测试输出目录：CatalogProvider 的"server 同目录"探测
         因此零配置命中，测试也就不必硬编码 bin 路径。 -->
    <ProjectReference Include="..\..\src\BubuUI.Runtime\BubuUI.Runtime.csproj" />
    <!-- 样式属性目录由 StyleBuilder/StyledProperty 符号派生（design/17 §4.3）；
         缺了渲染程序集，`Style="CornerRadius: 8"` 的补全会是空表。 -->
    <ProjectReference Include="..\..\src\BubuUI.Rendering\BubuUI.Rendering.csproj" />
  </ItemGroup>

</Project>
