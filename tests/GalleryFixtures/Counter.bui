@namespace Gallery
@using BubuUI.Elements

<StackPanel Gap="8">
    <TextBlock FontSize="30">You pressed {count} times</TextBlock>

    <CheckBox @bind-Checked={showButton}>Button visible</CheckBox>

    @if (showButton) {
        <Button OnClick={Test}>+1</Button>
    }
    
</StackPanel>

@code {
    public int count;

    public bool showButton;
    
    public bool showButton2;

    public void Test()
    {
        UpdateState(() => count++);
    }
}
