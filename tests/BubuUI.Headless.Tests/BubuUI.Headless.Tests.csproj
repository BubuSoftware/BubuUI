<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <!-- 前端结构测试的目录来自符号扫描（design/14 §14.11.1）：测试项目可以引用 Roslyn，
         生产侧 BubuUI.Compiler 保持零 Roslyn 依赖 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BubuUI.Runtime\BubuUI.Runtime.csproj" />
    <ProjectReference Include="..\..\src\BubuUI.Compiler\BubuUI.Compiler.csproj" />
    <ProjectReference Include="..\..\src\BubuUI.Compiler.Metadata\BubuUI.Compiler.Metadata.csproj" />
    <ProjectReference Include="..\..\src\BubuUI.Text.Shaping\BubuUI.Text.Shaping.csproj" />
    <!-- 真实 Fluent 画廊应用，以及与发布示例隔离的旧编译器回归夹具。 -->
    <ProjectReference Include="..\..\samples\Gallery\Gallery.csproj" />
    <ProjectReference Include="../GalleryFixtures/GalleryFixtures.csproj" />
    <ProjectReference Include="..\..\src\BubuUI.Compiler.Generator\BubuUI.Compiler.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 测试自有 .bui 夹具（S1Probe 原在 samples/CounterApp，2026-11-09 移入，画廊不再承担测试职责） -->
  <ItemGroup>
    <AdditionalFiles Include="Fixtures\**\*.bui;Fixtures\**\*.bss" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UiTestCatalogs.cs" Link="UiTestCatalogs.cs" />
  </ItemGroup>

</Project>
