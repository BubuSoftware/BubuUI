@namespace BubuUI.Headless.Tests
@using BubuUI.Elements

<Window Title={TitleText}>
    <StackPanel Ref={Panel}>
        <TextBlock>{TitleText}</TextBlock>
    </StackPanel>
</Window>

@code {
    public StackPanel? Panel;
    public string TitleText = "first";
    public System.Collections.Generic.List<string> Log = new();
    public bool ReadyWhenInitialized;
    public string? TitleAfterUpdate;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ReadyWhenInitialized = IsInitialized && Panel is not null && ReferenceEquals(Content, Panel) && Title == TitleText;
        Log.Add("initialized");
    }

    protected override void OnAttached() { base.OnAttached(); Log.Add("attached"); }
    protected override void OnDetached() { Log.Add("detached"); base.OnDetached(); }
    protected override void OnUpdating() { base.OnUpdating(); Log.Add("updating"); }
    protected override void OnUpdated()
    {
        base.OnUpdated();
        TitleAfterUpdate = Title;
        Log.Add("updated");
    }
    protected override void OnDispose() { Log.Add("disposed"); base.OnDispose(); }
}
