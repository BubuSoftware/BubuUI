@namespace BubuUI.Headless.Tests
@using BubuUI.Elements

@* 端到端夹具：.bui 控件标签上的 Class / Style / 附加属性直接落在当前实例上。
   根元素自带本文件 @style 声明的类（ComponentTagTarget__own），用来验证「外部类合并到自身类之后」。 *@

@style {
    .own {
        CornerRadius: 6;
    }
}

<WrapPanel Class="own">
    <TextBlock FontSize="12">{label}</TextBlock>
</WrapPanel>

@code {
    public string label = "target";
}
