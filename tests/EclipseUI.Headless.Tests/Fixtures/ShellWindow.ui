@namespace EclipseUI.Headless.Tests
@using EclipseUI.Elements

<Window Title={TitleText} Width={W} Height={H}>
    <StackPanel Gap="8">
        <TextBlock FontSize="20">Shell content</TextBlock>
    </StackPanel>
</Window>

@code {
    // 应用侧传入初值后统一初始化；动态槽直接更新当前窗口实例的属性。
    [UiParameter] public string TitleText { get; set; } = "Shell";
    [UiParameter] public double W { get; set; }
    [UiParameter] public double H { get; set; }
}
