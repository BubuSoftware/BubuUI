@namespace EclipseUI.Headless.Tests
@using EclipseUI.Elements

<StackPanel>
    <TextBlock Ref={Label}>{Message}</TextBlock>
</StackPanel>

@code {
    public TextBlock? Label;
    public string Message = "first";
    public System.Collections.Generic.List<string> Log = new();
    public bool ReadyWhenInitialized;
    public string? TextAfterUpdate;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ReadyWhenInitialized = IsInitialized && Label is not null && Label.FullText() == Message;
        Log.Add("initialized");
    }

    protected override void OnAttached() { base.OnAttached(); Log.Add("attached"); }
    protected override void OnDetached() { Log.Add("detached"); base.OnDetached(); }
    protected override void OnUpdating() { base.OnUpdating(); Log.Add("updating"); }
    protected override void OnUpdated()
    {
        base.OnUpdated();
        TextAfterUpdate = Label?.FullText();
        Log.Add("updated");
    }
    protected override void OnDispose() { Log.Add("disposed"); base.OnDispose(); }
}
