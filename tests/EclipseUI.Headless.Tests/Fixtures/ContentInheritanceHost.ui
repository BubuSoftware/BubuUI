@namespace EclipseUI.Headless.Tests
@using EclipseUI.Elements

<StackPanel>
    <ContentInherited Ref={ExplicitCard}>
        <TextBlock>external content</TextBlock>
    </ContentInherited>
    <ContentInherited Ref={DefaultCard}/>
</StackPanel>

@code {
    public ContentInherited ExplicitCard = null!;
    public ContentInherited DefaultCard = null!;
}
