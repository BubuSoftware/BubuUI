<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <!-- 前端结构测试的目录来自符号扫描（design/14 §14.11.1）：测试项目可以引用 Roslyn，
         生产侧 EclipseUI.Compiler 保持零 Roslyn 依赖 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EclipseUI.Runtime\EclipseUI.Runtime.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Compiler\EclipseUI.Compiler.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Compiler.Metadata\EclipseUI.Compiler.Metadata.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Text.Shaping\EclipseUI.Text.Shaping.csproj" />
    <!-- 画廊共享 UI（展示页 Counter/TaskList/Prefs 作为端到端夹具）；平台入口 Gallery.Desktop 不参与测试 -->
    <ProjectReference Include="..\..\samples\Gallery\Gallery.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Compiler.Generator\EclipseUI.Compiler.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 测试自有 .ui 夹具（S1Probe 原在 samples/CounterApp，2026-11-09 移入，画廊不再承担测试职责） -->
  <ItemGroup>
    <AdditionalFiles Include="Fixtures\**\*.ui;Fixtures\**\*.eustyle" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UiTestCatalogs.cs" Link="UiTestCatalogs.cs" />
  </ItemGroup>

</Project>
