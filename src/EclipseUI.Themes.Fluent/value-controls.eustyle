@namespace EclipseUI.Themes.Fluent
@using EclipseUI.Elements;

@theme FluentCheckBox for CheckBox {
    Template: template(FluentCheckBoxTemplate);
    GlyphSize: 20;
    MinHeight: 32;
    Background: resource(FluentResources.ControlAltBackground);
    Foreground: resource(FluentResources.Foreground);
    BorderBrush: resource(FluentResources.ControlStrongBorder);
    CornerRadius: 4;
    &:hover { Background: resource(FluentResources.ControlAltHoverBackground); }
    &:pressed { Background: resource(FluentResources.ControlAltPressedBackground); }
    &:disabled {
        Background: resource(FluentResources.DisabledBackground);
        Foreground: resource(FluentResources.DisabledForeground);
        BorderBrush: resource(FluentResources.ControlStrongDisabledBorder);
    }
}

@theme FluentRadioButton for RadioButton {
    Template: template(FluentRadioButtonTemplate);
    GlyphSize: 20;
    MinHeight: 32;
    Background: resource(FluentResources.ControlAltBackground);
    Foreground: resource(FluentResources.Foreground);
    BorderBrush: resource(FluentResources.ControlStrongBorder);
    &:hover { Background: resource(FluentResources.ControlAltHoverBackground); }
    &:pressed { Background: resource(FluentResources.ControlAltPressedBackground); }
    &:disabled {
        Background: resource(FluentResources.DisabledBackground);
        Foreground: resource(FluentResources.DisabledForeground);
        BorderBrush: resource(FluentResources.ControlStrongDisabledBorder);
    }
}

@theme FluentToggleSwitch for ToggleSwitch {
    Template: template(FluentToggleSwitchTemplate);
    MinHeight: 32;
    Background: resource(FluentResources.ControlAltBackground);
    Foreground: resource(FluentResources.Foreground);
    BorderBrush: resource(FluentResources.ControlStrongBorder);
    &:hover { Background: resource(FluentResources.ControlAltHoverBackground); }
    &:pressed { Background: resource(FluentResources.ControlAltPressedBackground); }
    &:disabled {
        Background: resource(FluentResources.DisabledBackground);
        Foreground: resource(FluentResources.DisabledForeground);
        BorderBrush: resource(FluentResources.ControlStrongDisabledBorder);
    }
}

@theme FluentToggleButton for ToggleButton {
    Template: template(FluentToggleButtonTemplate);
    Background: resource(FluentResources.ControlBackground);
    Foreground: resource(FluentResources.Foreground);
    BorderBrush: resource(FluentResources.ControlBorder);
    CornerRadius: 4;
    HorizontalPadding: 12;
    VerticalPadding: 5;
    MinHeight: 32;
    &:hover { Background: resource(FluentResources.ControlHoverBackground); }
    &:pressed {
        Background: resource(FluentResources.ControlPressedBackground);
        Foreground: resource(FluentResources.PressedForeground);
    }
    &:disabled {
        Background: resource(FluentResources.DisabledBackground);
        Foreground: resource(FluentResources.DisabledForeground);
    }
}

@theme FluentSlider for Slider {
    Template: template(FluentSliderTemplate);
    ThumbSize: 22;
}

@theme FluentProgressBar for ProgressBar {
    Template: template(FluentProgressBarTemplate);
    Height: 3;
}
