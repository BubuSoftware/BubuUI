@namespace EclipseUI.Themes.Fluent
@using EclipseUI.Elements
@template DatePicker

<Grid ColumnDefinitions="*,32">
    <TextBox Part="PART_Editor" Placeholder="yyyy-MM-dd" />
    <DropDownButton Grid.Column="1" Part="PART_Button" IsTabStop="false" />
    <Popup Part="PART_Popup" PlacementTarget={Owner} IsOpen={Owner.IsDropDownOpen}>
        <Calendar Part="PART_Calendar" />
    </Popup>
    <FluentDatePickerFocusVisual Owner={Owner} Grid.ColumnSpan="2" IsHitTestVisible="false" />
</Grid>
