<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BubuUI.Compiler.Metadata</RootNamespace>
    <Description>BubuUI component registry: Roslyn symbol scanner building the template catalog (design/14 §14.5/§14.10).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- 诊断码常量与前端共用一份定义（design/14 §14.9.1 是唯一码表）。
       PrivateAssets=all：不把 BubuUI.Compiler.dll 传递给消费者。测试项目引用生成器
       （已源码内嵌全部 Compiler 类型），若这里再流转 Compiler.dll 会制造重复类型歧义。
       C2 把本项目源码链接进生成器时，改为 Exclude 而非 ProjectReference。 -->
  <ItemGroup>
    <ProjectReference Include="..\BubuUI.Compiler\BubuUI.Compiler.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
