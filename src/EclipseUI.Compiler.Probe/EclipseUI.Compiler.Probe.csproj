<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>EclipseUI.Compiler.Probe</RootNamespace>
    <AssemblyName>EclipseUI.Compiler.Probe</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Description>Roslyn-only expression probe core shared by the source generator (compile-included) and the language server (project-referenced): design/06 §6.3 expression projection.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只依赖 Roslyn，不引用 Compiler/Metadata：生成器以源码并入本项目（与 Compiler/Metadata
         同模式），LSP 以 ProjectReference 引用——两边的探针类型必须是同一个实现（单一事实源），
         但不能经程序集引用混进生成器（那会与源码并入的 Compiler/Metadata 产生两份类型）。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
