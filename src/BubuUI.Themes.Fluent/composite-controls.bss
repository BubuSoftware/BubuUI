@namespace BubuUI.Themes.Fluent
@using BubuUI.Elements;

@theme FluentComboBox for ComboBox {
    Template: template(FluentComboBoxTemplate);
    MinWidth: 100;
    MinHeight: 32;
    CornerRadius: 4;
    FocusVisualMode: Control;
}
@theme FluentDatePicker for DatePicker {
    Template: template(FluentDatePickerTemplate);
    MinHeight: 32;
    CornerRadius: 4;
    FocusVisualMode: Control;
}
@theme FluentCalendar for Calendar {
    Template: template(FluentCalendarTemplate);
    PreferredWidth: 252;
    HeaderHeight: 32;
    WeekHeaderHeight: 24;
    DayHeight: 28;
    Background: resource(FluentResources.PopupBackground);
    Foreground: resource(FluentResources.Foreground);
    CornerRadius: 4;
    &:disabled { Foreground: resource(FluentResources.DisabledForeground); }
}
@theme FluentDropDownButton for DropDownButton {
    Template: template(FluentDropDownButtonTemplate);
    MinHeight: 32;
    HorizontalPadding: 12;
    VerticalPadding: 5;
    LabelAlignment: Left;
    CornerRadius: 4;
    Background: resource(FluentResources.ControlBackground);
    Foreground: resource(FluentResources.Foreground);
    BorderBrush: resource(FluentResources.ControlBorder);
    &:hover { Background: resource(FluentResources.ControlHoverBackground); }
    &:pressed { Background: resource(FluentResources.ControlPressedBackground); Foreground: resource(FluentResources.PressedForeground); }
    &:disabled { Background: resource(FluentResources.DisabledBackground); Foreground: resource(FluentResources.DisabledForeground); }
}
@theme FluentDataGridColumnHeader for DataGridColumnHeader {
    Template: template(FluentDataGridColumnHeaderTemplate);
    MinHeight: 32;
    HorizontalPadding: 12;
    VerticalPadding: 5;
    CornerRadius: 4;
    Background: resource(FluentResources.ControlBackground);
    Foreground: resource(FluentResources.Foreground);
    BorderBrush: resource(FluentResources.ControlBorder);
    &:hover { Background: resource(FluentResources.ControlHoverBackground); }
    &:pressed { Background: resource(FluentResources.ControlPressedBackground); Foreground: resource(FluentResources.PressedForeground); }
    &:disabled { Background: resource(FluentResources.DisabledBackground); Foreground: resource(FluentResources.DisabledForeground); }
}
@theme FluentMenuItem for MenuItem {
    Template: template(FluentMenuItemTemplate);
    HorizontalPadding: 8;
    VerticalPadding: 6;
    SubmenuIndicatorWidth: 16;
    Background: #00000000;
    &:hover { Background: resource(FluentResources.ItemHoverBackground); }
    &:pressed { Background: resource(FluentResources.ItemPressedBackground); Foreground: resource(FluentResources.PressedForeground); }
    Foreground: resource(FluentResources.Foreground);
    CornerRadius: 4;
    &:disabled { Background: #00000000; Foreground: resource(FluentResources.DisabledForeground); }
}
@theme FluentTreeViewItem for TreeViewItem {
    Template: template(FluentTreeViewItemTemplate);
    HeaderHeight: 28;
    HeaderPadding: 28;
    Indent: 20;
    Background: resource(FluentResources.TreeItemBackground);
    Foreground: resource(FluentResources.Foreground);
    CornerRadius: 4;
    &:disabled { Foreground: resource(FluentResources.DisabledForeground); }
}
@theme FluentTabControl for TabControl {
    Template: template(FluentTabControlTemplate);
    HeaderHeight: 34;
    HeaderPadding: 12;
    Foreground: resource(FluentResources.Foreground);
    CornerRadius: 4;
    &:disabled { Foreground: resource(FluentResources.DisabledForeground); }
}
@theme FluentDataGrid for DataGrid {
    Template: template(FluentDataGridTemplate);
    RowHeight: 36;
}
