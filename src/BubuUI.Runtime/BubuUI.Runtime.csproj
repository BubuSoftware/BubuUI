<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>BubuUI</RootNamespace>
    <Description>BubuUI runtime: signals, property engine, element tree, layout, block coordinators.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <!-- 平台生命周期安装窗口对象的属性回推通道。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="BubuUI.Rendering" />
    <InternalsVisibleTo Include="BubuUI.Platform.Windows" />
    <InternalsVisibleTo Include="BubuUI.Platform.Linux" />
    <InternalsVisibleTo Include="BubuUI.Platform.MacOS" />
    <InternalsVisibleTo Include="BubuUI.WindowLifetime.Tests" />
  </ItemGroup>

</Project>
