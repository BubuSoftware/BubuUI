<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EclipseUI</RootNamespace>
    <Description>EclipseUI runtime: signals, property engine, element tree, layout, block coordinators.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <!-- 平台生命周期安装窗口对象的属性回推通道。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="EclipseUI.Rendering" />
    <InternalsVisibleTo Include="EclipseUI.Platform.Windows" />
    <InternalsVisibleTo Include="EclipseUI.Platform.Linux" />
    <InternalsVisibleTo Include="EclipseUI.Platform.MacOS" />
  </ItemGroup>

</Project>
