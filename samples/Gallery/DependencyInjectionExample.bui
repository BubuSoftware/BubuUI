@namespace Gallery
@using BubuUI
@using BubuUI.Elements
@using Gallery.Services
@inject IGalleryDemoState DemoState

@* K37 依赖注入示例：@inject 一行声明——生成器发射
   「public IGalleryDemoState DemoState { get; private set; } = null!;」属性，
   并在 InitializeUi 最前语句从 Application.Current.Services 解析（R11 fail-fast：
   服务未注册或应用未构建即抛 InvalidOperationException，不构建内容树）。
   注册在平台宿主（Gallery.Desktop/Program.cs、Gallery.Android/MainApplication.cs）：
   services.AddSingleton<IGalleryDemoState, GalleryDemoState>()。
   单例语义演示：点击计数 Clicks 跨「Reset controls」的视觉树重建存续，
   构建计数 Builds 每次重建 +1——服务生命周期与 UI 生命周期解耦。 *@
<FluentExampleRow Title="Dependency injection">
    <Slot Name="Control">
        <Button Canvas.Left="8" Canvas.Top="8" Width="160" Ref={DemoButton} OnClick={RecordClick}>Click me</Button>
    </Slot>
</FluentExampleRow>

@code {
    private Button DemoButton = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        DemoState.RegisterBuild();
        RefreshLabel();
    }

    private void RecordClick()
    {
        DemoState.RegisterClick();
        RefreshLabel();
    }

    private void RefreshLabel() =>
        DemoButton.Label = $"Clicks: {DemoState.Clicks} · builds: {DemoState.Builds}";
}
