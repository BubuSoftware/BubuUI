<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gallery</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>EclipseUI 画廊共享 UI（平台无关）：展示页（Counter/TaskList/Prefs）+ 主场景 + 文本/截图辅助。平台入口见 Gallery.Desktop。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EclipseUI.Runtime\EclipseUI.Runtime.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Rendering\EclipseUI.Rendering.csproj" />
    <ProjectReference Include="../../src/EclipseUI.Themes.Fluent/EclipseUI.Themes.Fluent.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Rendering.Vello\EclipseUI.Rendering.Vello.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Text.Shaping\EclipseUI.Text.Shaping.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Compiler.Generator\EclipseUI.Compiler.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**\*.ui;**\*.eustyle" />
  </ItemGroup>

</Project>
