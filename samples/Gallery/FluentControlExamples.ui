@namespace Gallery
@using EclipseUI
@using EclipseUI.Elements
@using Gallery.Services

<StackPanel Padding="24" Gap="0" MaxWidth="640" HorizontalAlignment="Left">
    <Grid ColumnDefinitions="*,180" Height="48">
        <TextBlock FontSize="13" Margin="8" Style="Foreground: theme(#FFFFFFC5, #0000009E)">Control</TextBlock>
        <TextBlock Grid.Column="1" FontSize="13" Margin="8" Style="Foreground: theme(#FFFFFFC5, #0000009E)">Interactive</TextBlock>
    </Grid>
    <FluentExampleRow Title="Button">
        <Slot Name="Control"><Button Canvas.Left="8" Canvas.Top="8" Width="160">Standard button</Button></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="Toggle button / on">
        <Slot Name="Control"><ToggleButton Canvas.Left="8" Canvas.Top="8" Width="160" Checked="true">Selected</ToggleButton></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="TextBox">
        <Slot Name="Control"><TextBox Canvas.Left="8" Canvas.Top="8" Width="160" Text="Editable text" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="Placeholder">
        <Slot Name="Control"><TextBox Canvas.Left="8" Canvas.Top="8" Width="160" Placeholder="Enter a value" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="ComboBox">
        <Slot Name="Control"><ComboBox Canvas.Left="8" Canvas.Top="8" Width="160" ItemsSource={Choices} SelectedIndex="0" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="CheckBox / off">
        <Slot Name="Control"><CheckBox Canvas.Left="8" Canvas.Top="8" Label="Option" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="CheckBox / on">
        <Slot Name="Control"><CheckBox Canvas.Left="8" Canvas.Top="8" Label="Option" Checked="true" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="Indeterminate">
        <Slot Name="Control"><CheckBox Canvas.Left="8" Canvas.Top="8" Label="Option" IsIndeterminate="true" IsThreeState="true" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="RadioButton / off">
        <Slot Name="Control"><RadioButton Canvas.Left="8" Canvas.Top="8" Label="Option" GroupName="gallery-options" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="RadioButton / on">
        <Slot Name="Control"><RadioButton Canvas.Left="8" Canvas.Top="8" Label="Option" GroupName="gallery-options" Checked="true" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="ToggleSwitch / off">
        <Slot Name="Control"><ToggleSwitch Canvas.Left="8" Canvas.Top="8" Label="Off" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="ToggleSwitch / on">
        <Slot Name="Control"><ToggleSwitch Canvas.Left="8" Canvas.Top="8" Label="On" Checked="true" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="Slider">
        <Slot Name="Control"><Slider Canvas.Left="8" Canvas.Top="8" Width="160" Value="40" /></Slot>
    </FluentExampleRow>
    <FluentExampleRow Title="ProgressBar">
        <Slot Name="Control"><ProgressBar Canvas.Left="8" Canvas.Top="22" Width="160" Value="40" /></Slot>
    </FluentExampleRow>
</StackPanel>

@code {
    private readonly string[] Choices = ["Alpha", "Beta", "Gamma"];
    public IReadOnlyList<FluentExampleRow> Rows => Children.OfType<FluentExampleRow>().ToArray();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // K37 @inject 示例行（DependencyInjectionExample）：仅当宿主注册了 IGalleryDemoState 时挂载。
        // 测试/沙箱直接 new 本模板时没有 Application/服务容器（解析会 fail-fast 抛出），
        // 跳过挂载以保持 14 行控件目录不变；真实宿主（Gallery.Desktop / Gallery.Android）
        // 在 ConfigureServices 注册服务后即可见。
        if (Application.Current?.Services.GetService(typeof(IGalleryDemoState)) is not null)
        {
            var demo = new DependencyInjectionExample();
            demo.EnsureInitialized();
            Children.Add(demo);
        }
    }
}
