@namespace Gallery
@using EclipseUI
@using EclipseUI.Elements

<Window Title="EclipseUI Gallery" Width={W} Height={H}>
    <FluentGalleryPage Ref={Page} />
</Window>

@code {
    [UiParameter] public double W { get; set; }
    [UiParameter] public double H { get; set; }
    public FluentGalleryPage Page = null!;
    public Button ThemeButton => Page.ThemeButton;
    public ScrollViewer RootViewer => Page.Viewer;
}
