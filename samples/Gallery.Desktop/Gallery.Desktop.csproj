<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Gallery.Desktop</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>EclipseUI 画廊的 Windows 平台入口（Avalonia 式分层）：Win32 窗口 + 主循环，仅负责展示与截图。验证/自检见 sandbox/GalleryCheck。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gallery\Gallery.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Platform.Windows\EclipseUI.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\EclipseUI.Rendering.Vello\EclipseUI.Rendering.Vello.csproj" />
  </ItemGroup>

</Project>
